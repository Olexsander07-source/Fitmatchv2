:root {
  --bg: #0d0a0b;
  --panel: #171113;
  --panel2: #21191b;
  --line: #382b2e;

  --text: #f8f1f2;
  --muted: #aa9da0;

  --accent: #e9b8c3;
  --accent-light: #f7dce2;

  --danger: #ff8d8d;
  --success: #8ee59b;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(233, 184, 195, 0.08),
      transparent 30%
    ),
    var(--bg);

  color: var(--text);

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}


/* =========================
   HEADER
========================= */

.header {
  min-height: 76px;

  border-bottom:
    1px solid var(--line);

  display: flex;

  align-items: center;
  justify-content: space-between;

  padding: 0 5%;

  position: sticky;
  top: 0;

  background:
    rgba(13, 10, 11, 0.94);

  backdrop-filter: blur(12px);

  z-index: 10;
}

.logo {
  font-size: 23px;

  font-weight: 900;

  letter-spacing: 1px;

  background: none;

  border: 0;

  color: var(--text);
}

.logo span {
  color: var(--accent);
}

.hamburger {
  display: none;

  background: none;

  color: var(--text);

  border: 0;

  font-size: 24px;
}

.nav {
  display: flex;

  gap: 8px;
}

.nav button {
  background: none;

  border: 0;

  color: var(--muted);

  padding: 8px 10px;

  transition:
    color 0.2s;
}

.nav button:hover {
  color: var(--accent);
}


/* =========================
   HEADER ACTIONS
========================= */

.header-actions {
  display: flex;

  gap: 10px;

  align-items: center;
}


/* =========================
   BUTTONS
========================= */

.actions {
  display: flex;

  gap: 10px;

  flex-wrap: wrap;

  margin-top: 20px;
}

.login-btn,
.btn {
  padding: 11px 17px;

  border:
    1px solid var(--accent);

  background: transparent;

  color: var(--text);

  border-radius: 7px;

  transition:
    transform 0.2s,
    background 0.2s,
    color 0.2s,
    box-shadow 0.2s;
}

.btn-primary {
  background: var(--accent);

  color: #170f11;

  font-weight: 800;

  border-color: var(--accent);
}

.btn:hover,
.login-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 25px
    rgba(233, 184, 195, 0.15);
}

.btn-primary:hover {
  background: var(--accent-light);
}


/* =========================
   PAGES
========================= */

.page {
  display: none;

  min-height:
    calc(100vh - 76px);
}

.page.active {
  display: block;
}

.container {
  max-width: 1200px;

  margin: auto;

  padding: 55px 25px;
}


/* =========================
   HERO
========================= */

.hero {
  min-height: 570px;

  display: grid;

  grid-template-columns:
    1.4fr 0.6fr;

  align-items: center;

  gap: 55px;
}

.eyebrow {
  color: var(--accent);

  font-size: 11px;

  letter-spacing: 3px;

  font-weight: 700;

  text-transform: uppercase;
}

h1 {
  font-size:
    clamp(
      46px,
      8vw,
      100px
    );

  line-height: 0.9;

  margin: 20px 0;

  letter-spacing: -4px;
}

h1 em {
  color: var(--accent);

  font-style: normal;
}

.page-title {
  font-size:
    clamp(
      48px,
      8vw,
      90px
    );

  margin-bottom: 45px;
}

.lead {
  color: var(--muted);

  line-height: 1.7;

  max-width: 620px;
}


/* =========================
   HERO SCORE / SALON CARD
========================= */

.score-box {
  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  padding: 32px;

  border-radius: 14px;

  box-shadow:
    0 20px 60px
    rgba(0, 0, 0, 0.3);
}

.score {
  font-size: 82px;

  color: var(--accent);

  font-weight: 900;

  line-height: 1;
}


/* =========================
   SECTIONS
========================= */

.section {
  padding: 35px 0;
}

.dark {
  background:
    rgba(23, 17, 19, 0.75);
}

.section-title {
  font-size: 32px;

  margin-bottom: 28px;

  letter-spacing: -1px;
}


/* =========================
   SERVICES
========================= */

.sports-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 16px;
}

.sport-card {
  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  padding: 22px;

  border-radius: 12px;

  cursor: pointer;

  min-height: 155px;

  transition:
    transform 0.25s,
    border-color 0.25s,
    box-shadow 0.25s;
}

.sport-card:hover {
  border-color: var(--accent);

  transform: translateY(-4px);

  box-shadow:
    0 15px 35px
    rgba(0, 0, 0, 0.25);
}

.sport-card h3 {
  margin-top: 0;

  font-size: 20px;
}

.sport-card p {
  color: var(--muted);

  line-height: 1.5;
}


/* =========================
   MASTERS
========================= */

.coach-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.coach-card {
  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  padding: 20px;

  border-radius: 12px;

  cursor: pointer;

  transition:
    transform 0.25s,
    border-color 0.25s,
    box-shadow 0.25s;
}

.coach-card:hover {
  border-color: var(--accent);

  transform: translateY(-4px);

  box-shadow:
    0 15px 35px
    rgba(0, 0, 0, 0.25);
}

.coach-avatar {
  width: 72px;
  height: 72px;

  background:
    linear-gradient(
      145deg,
      var(--panel2),
      #302225
    );

  border-radius: 50%;

  display: grid;

  place-items: center;

  color: var(--accent);

  font-weight: 900;

  margin-bottom: 15px;

  border:
    1px solid var(--line);

  overflow: hidden;
}

.coach-avatar img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.coach-score {
  float: right;

  color: var(--accent);

  font-weight: 900;
}

.tags {
  margin: 12px 0;
}

.tag {
  display: inline-block;

  border:
    1px solid var(--line);

  padding: 5px 9px;

  color: var(--muted);

  font-size: 12px;

  border-radius: 20px;

  margin-right: 5px;

  margin-bottom: 5px;
}

.card-footer {
  border-top:
    1px solid var(--line);

  padding-top: 14px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 10px;

  color: var(--muted);
}


/* =========================
   FILTERS
========================= */

.filters {
  display: flex;

  gap: 12px;

  margin-bottom: 25px;
}

.filters select,
.match-box select,
.form input,
.form select,
.form textarea {
  width: 100%;

  padding: 13px;

  border-radius: 8px;

  border:
    1px solid var(--line);

  background: var(--panel2);

  color: var(--text);

  outline: none;

  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.filters select:focus,
.match-box select:focus,
.form input:focus,
.form select:focus,
.form textarea:focus {
  border-color: var(--accent);

  box-shadow:
    0 0 0 3px
    rgba(233, 184, 195, 0.08);
}


/* =========================
   BOOKING
========================= */

.match-box {
  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  padding: 30px;

  border-radius: 14px;

  max-width: 720px;
}

.match-box label {
  display: block;

  margin-bottom: 16px;

  color: var(--muted);
}

.match-result {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  padding: 15px;

  margin-top: 10px;

  background: var(--panel2);

  border:
    1px solid var(--line);

  border-radius: 8px;
}

.match-result:hover {
  border-color: var(--accent);
}

.match-percent {
  color: var(--accent);

  font-weight: 900;
}


/* =========================
   REVIEWS
========================= */

.review {
  padding: 20px;

  margin-top: 12px;

  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  border-radius: 10px;
}

.review-box {
  margin-top: 35px;

  background: var(--panel);

  border:
    1px solid var(--line);

  padding: 25px;

  border-radius: 12px;

  max-width: 700px;
}


/* =========================
   MODALS
========================= */

.modal {
  position: fixed;

  inset: 0;

  display: none;

  align-items: center;

  justify-content: center;

  background:
    rgba(0, 0, 0, 0.78);

  backdrop-filter: blur(5px);

  padding: 20px;

  z-index: 100;
}

.modal.show {
  display: flex;
}

.modal-content {
  width: 100%;

  max-width: 720px;

  max-height: 90vh;

  overflow: auto;

  position: relative;

  background:
    linear-gradient(
      145deg,
      var(--panel),
      var(--panel2)
    );

  border:
    1px solid var(--line);

  padding: 30px;

  border-radius: 14px;

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.5);
}


/* =========================
   FORMS
========================= */

.form label {
  display: block;

  margin: 14px 0;

  color: var(--muted);
}

.form input,
.form select,
.form textarea {
  margin-top: 7px;
}

textarea {
  min-height: 110px;

  resize: vertical;
}

.success {
  color: var(--success);

  margin-top: 15px;
}

.error {
  color: var(--danger);

  margin-top: 15px;
}


/* =========================
   AUTH LINKS
========================= */

.auth-link,
.forgot-password {
  background: none;

  border: 0;

  padding: 8px 0;

  color: var(--accent);

  text-decoration: underline;

  font-size: 14px;
}

.auth-link:hover,
.forgot-password:hover {
  opacity: 0.8;
}


/* =========================
   FOOTER
========================= */

footer {
  padding: 30px 20px;

  text-align: center;

  color: var(--muted);

  border-top:
    1px solid var(--line);

  margin-top: 30px;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

  .sports-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .coach-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .hero {
    grid-template-columns:
      1fr;
  }

  .score-box {
    max-width: 500px;
  }
}


@media (max-width: 700px) {

  .hamburger {
    display: block;
  }

  .nav {
    display: none;
  }

  .nav.mobile-open {
    display: flex;

    position: absolute;

    top: 76px;

    left: 0;

    right: 0;

    background:
      rgba(13, 10, 11, 0.98);

    flex-direction: column;

    padding: 15px;

    border-bottom:
      1px solid var(--line);

    box-shadow:
      0 15px 30px
      rgba(0, 0, 0, 0.3);
  }

  .hero,
  .coach-grid,
  .sports-grid {
    grid-template-columns:
      1fr;
  }

  .header {
    padding: 0 12px;
  }

  .container {
    padding: 35px 18px;
  }

  .filters {
    flex-direction: column;
  }

  .header-actions {
    gap: 5px;
  }

  .header-actions .btn,
  .header-actions .login-btn {
    padding: 8px 10px;

    font-size: 12px;
  }

  .modal {
    padding: 12px;
  }

  .modal-content {
    padding: 20px;
  }

  h1 {
    letter-spacing: -2px;
  }

  .page-title {
    margin-bottom: 30px;
  }

  .score {
    font-size: 65px;
  }
}
