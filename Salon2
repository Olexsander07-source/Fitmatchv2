<!doctype html>
<html lang="ru">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>MANICURE — Маникюр и уход за ногтями</title>

  <meta
    name="description"
    content="Маникюрный салон. Маникюр, покрытие, дизайн ногтей и другие услуги. Выберите услугу и запишитесь онлайн."
  >

  <link rel="stylesheet" href="styles.css">
</head>


<body>

  <!-- ================= HEADER ================= -->

  <header class="header">

    <button
      class="logo"
      id="logo"
      type="button"
    >
      MANI<span>CURE</span>
    </button>


    <button
      id="hamburger"
      class="hamburger"
      type="button"
      aria-label="Открыть меню"
    >
      ☰
    </button>


    <nav
      id="mainNav"
      class="nav"
    >

      <button
        data-nav="home"
        type="button"
      >
        Главная
      </button>

      <button
        data-nav="services"
        type="button"
      >
        Услуги
      </button>

      <button
        data-nav="masters"
        type="button"
      >
        Мастера
      </button>

      <button
        data-nav="reviews"
        type="button"
      >
        Отзывы
      </button>

    </nav>


    <div class="header-actions">

      <button
        id="authBtn"
        class="btn"
        type="button"
      >
        Войти
      </button>

      <button
        id="bookingBtn"
        class="login-btn"
        type="button"
      >
        Записаться
      </button>

    </div>

  </header>



  <!-- ================= MAIN ================= -->

  <main>


    <!-- ================= HOME ================= -->

    <section
      id="home"
      class="page active"
    >

      <div class="container hero">

        <div>

          <p class="eyebrow">
            MANICURE STUDIO
          </p>


          <h1>
            КРАСИВЫЕ<br>
            <em>НОГТИ.</em><br>
            ТВОЙ СТИЛЬ.
          </h1>


          <p class="lead">
            Профессиональный маникюр,
            покрытие и дизайн ногтей.
            Выберите услугу и запишитесь онлайн.
          </p>


          <button
            class="btn btn-primary"
            id="bookingBtnHome"
            type="button"
          >
            ЗАПИСАТЬСЯ →
          </button>


          <button
            class="btn"
            id="chooseServiceBtn"
            type="button"
          >
            ВЫБРАТЬ УСЛУГУ
          </button>

        </div>


        <div class="score-box">

          <p class="eyebrow">
            НАШ САЛОН
          </p>


          <div class="score">
            5.0
          </div>


          <p class="lead">
            Рейтинг салона на основе
            отзывов наших клиентов.
          </p>

        </div>

      </div>



      <!-- ================= SERVICES ================= -->

      <div class="section dark">

        <div class="container">

          <h2 class="section-title">
            НАШИ УСЛУГИ
          </h2>


          <div
            class="sports-grid"
            id="homeServices"
          ></div>

        </div>

      </div>



      <!-- ================= TOP MASTERS ================= -->

      <div class="section">

        <div class="container">

          <h2 class="section-title">
            НАШИ МАСТЕРА
          </h2>


          <div
            class="coach-grid"
            id="topMasters"
          ></div>

        </div>

      </div>


    </section>



    <!-- ================= SERVICES PAGE ================= -->

    <section
      id="services"
      class="page"
    >

      <div class="container">

        <h1 class="page-title">
          ВЫБЕРИ<br>
          <em>УСЛУГУ.</em>
        </h1>


        <div
          class="sports-grid"
          id="servicesList"
        ></div>

      </div>

    </section>



    <!-- ================= MASTERS PAGE ================= -->

    <section
      id="masters"
      class="page"
    >

      <div class="container">

        <h1 class="page-title">
          НАЙДИ<br>
          <em>СВОЕГО МАСТЕРА.</em>
        </h1>


        <div
          class="coach-grid"
          id="mastersList"
        ></div>

      </div>

    </section>



    <!-- ================= REVIEWS PAGE ================= -->

    <section
      id="reviews"
      class="page"
    >

      <div class="container">

        <h1 class="page-title">
          ОТЗЫВЫ<br>
          <em>КЛИЕНТОВ.</em>
        </h1>


        <div id="reviewsList"></div>


        <div class="review-box">

          <h2>
            Оставить отзыв
          </h2>


          <form
            id="reviewForm"
            class="form"
          >

            <label>

              Оценка

              <select
                id="reviewRating"
                required
              >

                <option value="">
                  Выберите оценку
                </option>

                <option value="5">
                  ★★★★★ — 5
                </option>

                <option value="4">
                  ★★★★☆ — 4
                </option>

                <option value="3">
                  ★★★☆☆ — 3
                </option>

                <option value="2">
                  ★★☆☆☆ — 2
                </option>

                <option value="1">
                  ★☆☆☆☆ — 1
                </option>

              </select>

            </label>


            <label>

              Ваш отзыв

              <textarea
                id="reviewText"
                required
              ></textarea>

            </label>


            <button
              class="btn btn-primary"
              type="submit"
            >
              ОСТАВИТЬ ОТЗЫВ
            </button>


            <div id="reviewMessage"></div>

          </form>

        </div>

      </div>

    </section>



    <!-- ================= PROFILE ================= -->

    <section
      id="profile"
      class="page"
    >

      <div
        class="container"
        id="profileContent"
      ></div>

    </section>


  </main>



  <!-- ================= AUTH MODAL ================= -->

  <div
    id="modal"
    class="modal"
  >

    <div class="modal-content">

      <h2>
        Войти
      </h2>


      <form
        id="authForm"
        class="form"
      >

        <label>

          Email

          <input
            id="authEmail"
            type="email"
            autocomplete="email"
            required
          >

        </label>


        <label>

          Пароль

          <input
            id="authPassword"
            type="password"
            minlength="6"
            autocomplete="current-password"
            required
          >

        </label>


        <div class="actions">

          <button
            class="btn btn-primary"
            type="submit"
          >
            ВОЙТИ
          </button>


          <button
            id="signupBtn"
            class="btn"
            type="button"
          >
            РЕГИСТРАЦИЯ
          </button>


          <button
            id="modalCancel"
            class="btn"
            type="button"
          >
            ОТМЕНА
          </button>

        </div>


        <button
          id="forgotPasswordBtn"
          class="forgot-password"
          type="button"
        >
          Забыли пароль?
        </button>


        <div id="authMessage"></div>

      </form>

    </div>

  </div>



  <!-- ================= RESET PASSWORD ================= -->

  <div
    id="resetPasswordModal"
    class="modal"
  >

    <div class="modal-content">

      <h2>
        Создать новый пароль
      </h2>


      <p class="lead">
        Введите и подтвердите новый пароль.
      </p>


      <form
        id="resetPasswordForm"
        class="form"
      >

        <label>

          Новый пароль

          <input
            id="newPassword"
            type="password"
            minlength="6"
            autocomplete="new-password"
            required
          >

        </label>


        <label>

          Повторите пароль

          <input
            id="confirmPassword"
            type="password"
            minlength="6"
            autocomplete="new-password"
            required
          >

        </label>


        <div class="actions">

          <button
            class="btn btn-primary"
            type="submit"
          >
            СОХРАНИТЬ ПАРОЛЬ
          </button>


          <button
            id="resetCancel"
            class="btn"
            type="button"
          >
            ОТМЕНА
          </button>

        </div>


        <div id="resetMessage"></div>

      </form>

    </div>

  </div>



  <!-- ================= BOOKING MODAL ================= -->

  <div
    id="bookingModal"
    class="modal"
  >

    <div class="modal-content">

      <h2>
        Запись на маникюр
      </h2>


      <p class="lead">
        Выберите услугу, мастера,
        дату и удобное время.
      </p>


      <form
        id="bookingForm"
        class="form"
      >

        <label>

          Услуга

          <select
            id="bookingService"
            name="service_id"
            required
          >

            <option value="">
              Выберите услугу
            </option>

          </select>

        </label>


        <label>

          Мастер

          <select
            id="bookingMaster"
            name="master_id"
          >

            <option value="">
              Любой мастер
            </option>

          </select>

        </label>


        <label>

          Дата

          <input
            id="bookingDate"
            name="booking_date"
            type="date"
            required
          >

        </label>


        <label>

          Время

          <input
            id="bookingTime"
            name="booking_time"
            type="time"
            required
          >

        </label>


        <label>

          Ваше имя

          <input
            id="bookingName"
            name="client_name"
            type="text"
            autocomplete="name"
            required
          >

        </label>


        <label>

          Телефон

          <input
            id="bookingPhone"
            name="client_phone"
            type="tel"
            autocomplete="tel"
            required
          >

        </label>


        <label>

          Комментарий

          <textarea
            id="bookingComment"
            name="client_comment"
            placeholder="Например: хочу дизайн / есть старое покрытие..."
          ></textarea>

        </label>


        <div class="actions">

          <button
            class="btn btn-primary"
            type="submit"
          >
            ПОДТВЕРДИТЬ ЗАПИСЬ →
          </button>


          <button
            id="bookingCancel"
            class="btn"
            type="button"
          >
            ОТМЕНА
          </button>

        </div>


        <div id="bookingMessage"></div>

      </form>

    </div>

  </div>



  <!-- ================= FOOTER ================= -->

  <footer>

    © 2026 MANICURE STUDIO

  </footer>



  <!-- ================= JAVASCRIPT ================= -->

  <script
    type="module"
    src="fitmatch.js"
  ></script>


</body>

</html>
